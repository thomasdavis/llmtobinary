{
  "name": "@llmtobinary/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/prepare-z3-assets.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "types": "wrangler types --env-interface Env worker/worker-configuration.d.ts",
    "test:worker": "vitest run -c vitest.worker.config.ts",
    "deploy": "node ../../scripts/prepare-z3-assets.mjs && vite build && wrangler deploy",
    "deploy:staging": "node ../../scripts/prepare-z3-assets.mjs && CLOUDFLARE_ENV=staging vite build && wrangler deploy"
  },
  "dependencies": {
    "@llmtobinary/annotations": "workspace:*",
    "@llmtobinary/artifacts": "workspace:*",
    "@llmtobinary/broker": "workspace:*",
    "@llmtobinary/check": "workspace:*",
    "@llmtobinary/decode": "workspace:*",
    "@llmtobinary/devices": "workspace:*",
    "@llmtobinary/diagnostics": "workspace:*",
    "@llmtobinary/protocol": "workspace:*",
    "@llmtobinary/reference": "workspace:*",
    "@llmtobinary/runtime": "workspace:*",
    "@llmtobinary/spec": "workspace:*",
    "@llmtobinary/tasks": "workspace:*",
    "@llmtobinary/validate": "workspace:*",
    "@llmtobinary/verify": "workspace:*",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@llmtobinary/research": "workspace:*",
    "z3-solver": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260930.1",
    "@llmtobinary/fixture-builder": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.144.0"
  }
}
