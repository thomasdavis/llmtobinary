// llmtobinary — one Cloudflare Worker serving the Vite build as static assets and the /api/* broker.
// PRD Section 8.2. Secrets (OPENAI_API_KEY, SESSION_SIGNING_KEY) are NEVER set here: use
// `wrangler secret put <NAME> [--env staging]`; local development reads them from .dev.vars.
// Bindings are not inherited by environments, so staging/research repeat them explicitly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llmtobinary",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/sitemap.xml"]
  },
  // Production serves llmtobinary.com (www redirects to it). Named environments must not inherit these.
  // workers.dev stays on so older links keep working (they redirect to the domain).
  "workers_dev": true,
  "routes": [
    { "pattern": "llmtobinary.com", "custom_domain": true },
    { "pattern": "www.llmtobinary.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GENERATION_SESSION", "class_name": "GenerationSession" },
      { "name": "BUDGET_LEDGER", "class_name": "BudgetLedger" },
      { "name": "REGISTRY_LOG", "class_name": "RegistryLog" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GenerationSession", "BudgetLedger"] }, { "tag": "v2", "new_sqlite_classes": ["RegistryLog"] }],
  "ratelimits": [{ "name": "ADMISSION_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Private debug archive of generation sessions (never publicly readable; fetched with wrangler).
  "r2_buckets": [{ "binding": "DEBUG_ARCHIVE", "bucket_name": "llmtobinary-debug" }, { "binding": "REGISTRY", "bucket_name": "llmtobinary-registry" }],
  // Accounts and social data. Bindings are not inherited, so staging repeats its own.
  "d1_databases": [{ "binding": "COMMUNITY_DB", "database_name": "llmtobinary-community", "database_id": "79e2422f-dc86-49a1-b1d2-fa80dda3c2cb", "migrations_dir": "migrations" }],
  "observability": { "enabled": true },
  // Long generation attempts run many checks of large candidates in one Durable Object request.
  "limits": { "cpu_ms": 300000 },
  "vars": {
    "ENVIRONMENT": "production",
    "TRUSTED_KEYS": "[{\"keyid\": \"broker-production-1\", \"publicKeyHex\": \"4efcbcfd0b3b91e9c0c6d2281bfa3d446b9e533cf76fca4b52c38054affa98b6\", \"role\": \"broker\"}, {\"keyid\": \"verifier-production-1\", \"publicKeyHex\": \"0f3fd5e59c53213aa22fe36a0531bdd41ae96e7ba07426c3d447c4fda7fc2bd3\", \"role\": \"verifier\"}, {\"keyid\": \"verifier-production-2\", \"publicKeyHex\": \"08c141bb0b00a1fe2f36b31d9a4d81ab5aeb82684352f8f09e530264a33b2808\", \"role\": \"verifier\"}]",
    "BROKER_KEY_ID": "broker-production-1",
    "CANONICAL_HOST": "llmtobinary.com",
    "LIVE_GENERATION_ENABLED": "true",
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_PROFILE_LABEL": "GPT-6 Luna, medium reasoning",
    "OPENAI_REASONING_EFFORT": "medium",
    "OPENAI_OPEN_TASK_REASONING_EFFORT": "high",
    "OPENAI_CARRY_REASONING": "true",
    "OPENAI_PRICE_INPUT_PER_MTOK": "0.10",
    "OPENAI_PRICE_OUTPUT_PER_MTOK": "0.50",
    "SESSION_USD_CAP": "4.00",
    "DAILY_USD_CAP": "20.00",
    "RECOVERY_TTL_SECONDS": "7200",
    "ALLOWED_FEATURES": "15"
  },
  "env": {
    "staging": {
      "name": "llmtobinary-staging",
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "GENERATION_SESSION", "class_name": "GenerationSession" },
          { "name": "BUDGET_LEDGER", "class_name": "BudgetLedger" },
          { "name": "REGISTRY_LOG", "class_name": "RegistryLog" }
        ]
      },
      "ratelimits": [{ "name": "ADMISSION_LIMITER", "namespace_id": "4202", "simple": { "limit": 20, "period": 60 } }],
      "r2_buckets": [{ "binding": "DEBUG_ARCHIVE", "bucket_name": "llmtobinary-debug-staging" }, { "binding": "REGISTRY", "bucket_name": "llmtobinary-registry-staging" }],
      "d1_databases": [{ "binding": "COMMUNITY_DB", "database_name": "llmtobinary-community-staging", "database_id": "8d366f06-9d96-4471-9563-4c0628a8b6ed", "migrations_dir": "migrations" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "staging",
        "TRUSTED_KEYS": "[{\"keyid\": \"broker-staging-1\", \"publicKeyHex\": \"282a01ba7a348534aaae3f8dbcd4ed3eb33fc7f547076851de9e4c7ab9c97e8d\", \"role\": \"broker\"}, {\"keyid\": \"verifier-staging-1\", \"publicKeyHex\": \"80835db202cc9114e30ae9de44aed97d18de7ab98c92c2b4e76f47d7fdb27658\", \"role\": \"verifier\"}, {\"keyid\": \"verifier-staging-2\", \"publicKeyHex\": \"56dcf2a4e3b927fce24caf75144b35bf8bcd6565824536a1128cdef381acf312\", \"role\": \"verifier\"}]",
        "BROKER_KEY_ID": "broker-staging-1",
        "LIVE_GENERATION_ENABLED": "true",
        "OPENAI_MODEL": "gpt-6-luna",
        "OPENAI_PROFILE_LABEL": "GPT-6 Luna, medium reasoning",
        "OPENAI_REASONING_EFFORT": "medium",
        "OPENAI_OPEN_TASK_REASONING_EFFORT": "high",
        "OPENAI_CARRY_REASONING": "true",
        "OPENAI_PRICE_INPUT_PER_MTOK": "0.10",
        "OPENAI_PRICE_OUTPUT_PER_MTOK": "0.50",
        "SESSION_USD_CAP": "0.50",
        "DAILY_USD_CAP": "1.00",
        "RECOVERY_TTL_SECONDS": "7200",
        "ALLOWED_FEATURES": "15"
      }
    },
    "test": {
      "name": "llmtobinary-test",
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "GENERATION_SESSION", "class_name": "GenerationSession" },
          { "name": "BUDGET_LEDGER", "class_name": "BudgetLedger" }
        ]
      },
      "ratelimits": [{ "name": "ADMISSION_LIMITER", "namespace_id": "4204", "simple": { "limit": 60, "period": 60 } }],
      "r2_buckets": [{ "binding": "DEBUG_ARCHIVE", "bucket_name": "llmtobinary-debug-test" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "test",
        "LIVE_GENERATION_ENABLED": "false",
        "OPENAI_MODEL": "",
        "OPENAI_PROFILE_LABEL": "",
        "OPENAI_REASONING_EFFORT": "",
        "OPENAI_CARRY_REASONING": "false",
        "OPENAI_PRICE_INPUT_PER_MTOK": "",
        "OPENAI_PRICE_OUTPUT_PER_MTOK": "",
        "SESSION_USD_CAP": "1.00",
        "DAILY_USD_CAP": "5.00",
        "RECOVERY_TTL_SECONDS": "7200",
        "ALLOWED_FEATURES": "15"
      }
    },
    "research": {
      "name": "llmtobinary-research",
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "GENERATION_SESSION", "class_name": "GenerationSession" },
          { "name": "BUDGET_LEDGER", "class_name": "BudgetLedger" }
        ]
      },
      "ratelimits": [{ "name": "ADMISSION_LIMITER", "namespace_id": "4203", "simple": { "limit": 60, "period": 60 } }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "research",
        "LIVE_GENERATION_ENABLED": "false",
        "OPENAI_MODEL": "",
        "OPENAI_PROFILE_LABEL": "",
        "OPENAI_REASONING_EFFORT": "",
        "OPENAI_CARRY_REASONING": "false",
        "OPENAI_PRICE_INPUT_PER_MTOK": "",
        "OPENAI_PRICE_OUTPUT_PER_MTOK": "",
        "SESSION_USD_CAP": "2.00",
        "DAILY_USD_CAP": "0.00",
        "RECOVERY_TTL_SECONDS": "86400",
        "ALLOWED_FEATURES": "15"
      }
    }
  }
}
